# local-run secrets — copy to .env and fill in.
#
# `start.sh` will copy this template to `.env` on first run and prompt for
# any missing values (and persist what you type back into `.env`).
#
# `.env` is gitignored.

# ---- OAuth client used by Gateway (Keycloak token exchange) ----
# Realm client `kernelmind-auth` — used to exchange auth codes for tokens.
KEYCLOAK_OAUTH_CLIENT_ID=kernelmind-auth
KEYCLOAK_OAUTH_CLIENT_SECRET=

# ---- OAuth admin client used by Gatekeeper (Keycloak admin REST API) ----
# Realm client `gatekeeper-admin` — used to provision orgs/users/IDPs.
KEYCLOAK_ADMIN_CLIENT_ID=gatekeeper-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=
